APP_NAME=ARKA — Asset Reliability Knowledge Agent
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arka_kg
POSTGRES_USER=arka
POSTGRES_PASSWORD=arka
POSTGRES_ECHO=false

# Knowledge graph (Apache AGE)
AGE_GRAPH_NAME=arka_kg

# Vertex AI / Gemini
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# ADK Artifacts — kosongkan untuk memakai InMemoryArtifactService saat pengembangan
ARTIFACT_GCS_BUCKET=
