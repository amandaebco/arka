APP_NAME=ARKA — Asset Reliability Knowledge Agent
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=arka_kg
POSTGRES_USER=arka
POSTGRES_PASSWORD=arka
POSTGRES_ECHO=false

# Knowledge graph (Apache AGE)
AGE_GRAPH_NAME=arka_kg

# Vertex AI / Gemini
GOOGLE_CLOUD_PROJECT=ebco-aihack-amanda
# gemini-3.6-flash hanya tersedia di `global`, bukan region seperti us-central1.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30

# ADK Artifacts — kosongkan untuk memakai InMemoryArtifactService saat pengembangan
ARTIFACT_GCS_BUCKET=ebco-aihack-amanda-arka-staging

# Penggambar infografis — satu-satunya jalur yang memanggil penyedia di luar
# Google. Dipilih sadar untuk memperluas keragaman tumpukan teknologi; isinya
# terbatas pada nilai yang sudah ada di `Finding` (Constitution 1.2.0).
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536
IMAGE_QUALITY=high
