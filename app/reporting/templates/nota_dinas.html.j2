{% import "_blok.html.j2" as blok_makro %}
{# Nota dinas — Executive Enterprise Kop #}
<article class="memo dok-nota-dinas">
  {% if konteks.logo %}
  <div class="watermark-bg" style="background-image: url('{{ konteks.logo }}');"></div>
  {% endif %}


  <header class="kop kop-surat">
    <div class="kop-header-row">
      <div class="penerbit-container">
        {% if konteks.logo %}
        <img class="lencana" src="{{ konteks.logo }}" alt="">
        {% endif %}
        <div class="penerbit-info">
          <span class="unit-nama">{{ konteks.unit_penerbit or "INGOUDE COMPANY" }}</span>

          <span class="dok-sub">NOTA DINAS RESMI</span>
        </div>
      </div>

      <div class="doc-control-card">
        <span class="badge-status">RESTRICTED · OFFICIAL</span>
        <div class="doc-meta-item"><span class="lbl">No:</span> <span class="val">{{ konteks.nomor or "001/ARKA/VIII/2026" }}</span></div>
        <div class="doc-meta-item"><span class="lbl">Tgl:</span> <span class="val">{{ finding.dibuat_pada | tanggal }}</span></div>
      </div>
    </div>

    <div class="divider-double"></div>

    <dl class="identitas-memo">
      {% if konteks.kepada %}<div class="row"><dt>Kepada</dt><span class="colon">:</span><dd>{{ konteks.kepada }}</dd></div>{% endif %}
      {% if konteks.dari %}<div class="row"><dt>Dari</dt><span class="colon">:</span><dd>{{ konteks.dari }}</dd></div>{% endif %}
      <div class="row"><dt>Aset / Pabrik</dt><span class="colon">:</span><dd>{{ finding.equipment_tag }} · {{ finding.pabrik }}</dd></div>
      <div class="row"><dt>Perihal</dt><span class="colon">:</span><dd>{{ konteks.perihal or "Hasil Investigasi Keandalan Aset " ~ finding.equipment_tag }}</dd></div>
    </dl>
  </header>

  <p class="pembuka">
    Bersama ini kami sampaikan hasil investigasi keandalan aset
    <strong>{{ finding.equipment_tag }}</strong> di {{ finding.pabrik }}.
    Seluruh angka dan rujukan dokumen pada nota dinas ini dihasilkan langsung
    dari basis pengetahuan dan dapat ditelusuri ke sumbernya.
  </p>

  {% if finding.perlu_eskalasi %}
  <p class="eskalasi">
    <strong>Memerlukan keputusan.</strong>
    {{ finding.alasan_eskalasi or "Dua kandidat teratas berselisih di bawah ambang keyakinan." }}
  </p>
  {% endif %}

  {% for blok in blok_terpilih %}{{ blok_makro.render_blok(blok) }}{% endfor %}

  <p class="penutup">
    Demikian kami sampaikan. Atas perhatian dan tindak lanjut Anda,
    kami ucapkan terima kasih.
  </p>

  <div class="ttd-container">
    <div class="ttd-box">
      <div class="regards">Hormat kami,</div>
      <div class="ruang-ttd"></div>
      <div class="nama">{{ konteks.penanda_tangan or "( .......................... )" }}</div>
      {% if konteks.jabatan_penanda_tangan %}
      <div class="jabatan">{{ konteks.jabatan_penanda_tangan }}</div>
      {% endif %}
    </div>
  </div>

  {% if konteks.tembusan %}
  <div class="tembusan">
    <span>Tembusan:</span>
    <ol>{% for t in konteks.tembusan %}<li>{{ t }}</li>{% endfor %}</ol>
  </div>
  {% endif %}

  {{ blok_makro.jejak_asal(finding) }}
</article>


