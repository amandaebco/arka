{% import "_blok.html.j2" as blok_makro %}
{# Laporan investigasi — bentuk terlengkap, termasuk jejak penalaran agar
   pembaca yang skeptis dapat mengaudit cara ARKA sampai pada kesimpulan. #}
<article class="memo dok-laporan">
  <header class="kop">
    {% if konteks.unit_penerbit or konteks.logo %}
    <div class="penerbit">
      {% if konteks.logo %}<img class="lencana" src="{{ konteks.logo }}" alt="">{% endif %}
      {% if konteks.unit_penerbit %}<span class="unit">{{ konteks.unit_penerbit }}</span>{% endif %}
    </div>
    {% endif %}
    <h1>Laporan Investigasi Keandalan Aset</h1>
    <dl class="meta">
      <div><dt>Nomor</dt><dd>{{ konteks.nomor or finding.finding_id }}</dd></div>
      <div><dt>Tanggal</dt><dd>{{ finding.dibuat_pada | tanggal }}</dd></div>
      <div><dt>Aset</dt><dd>{{ finding.equipment_tag }}</dd></div>
      <div><dt>Pabrik</dt><dd>{{ finding.pabrik }}</dd></div>
    </dl>
    {% if konteks.periode %}<div class="periode">Periode: {{ konteks.periode }}</div>{% endif %}
  </header>

  {% if finding.perlu_eskalasi %}
  <p class="eskalasi">
    <strong>Perlu putusan manusia.</strong>
    {{ finding.alasan_eskalasi or "Dua kandidat teratas berselisih di bawah ambang keyakinan." }}
  </p>
  {% endif %}

  {% for blok in blok_terpilih %}{{ blok_makro.render_blok(blok) }}{% endfor %}

  {% if konteks.penanda_tangan %}
  <div class="ttd">
    {% if konteks.jabatan_penanda_tangan %}
    <div class="jabatan">{{ konteks.jabatan_penanda_tangan }}</div>
    {% endif %}
    <div class="ruang-ttd"></div>
    <div class="nama">{{ konteks.penanda_tangan }}</div>
  </div>
  {% endif %}

  {{ blok_makro.jejak_asal(finding) }}
</article>
